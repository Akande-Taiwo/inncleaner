# ---------------------------------------------------------------------------
# Copy this file to .env.local for development, and paste the same keys into
# Vercel > Project > Settings > Environment Variables for production.
# Never commit the filled-in version — .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Your shop's details (shown on the site) -------------------------------
STORE_NAME="Inn Resin Supply"
STORE_EMAIL="hello@yourdomain.com"
STORE_PHONE="+234 800 000 0000"
STORE_WHATSAPP="2348000000000"        # optional, digits only
STORE_INSTAGRAM="yourhandle"          # optional

# --- OPay account customers transfer to ------------------------------------
# These appear on the payment page. Until you set them, customers see a
# placeholder and the page warns you about it.
OPAY_ACCOUNT_NAME="Your Business Name"
OPAY_ACCOUNT_NUMBER="9012345678"
OPAY_BANK_NAME="OPay"

# --- Card payments via Paystack (optional) ---------------------------------
# From dashboard.paystack.com > Settings > API Keys & Webhooks.
# Leave blank and the card option is simply hidden — transfers still work.
# Use sk_test_... while testing, sk_live_... when you go live.
PAYSTACK_SECRET_KEY=""

# --- Order storage ---------------------------------------------------------
# Required in production. Without it, orders go to a local file, which does NOT
# work on Vercel. Vercel Postgres, Neon and Supabase all give you this string.
DATABASE_URL=""

# --- Admin area (/admin) ---------------------------------------------------
# ADMIN_PASSWORD is what you type to sign in.
# ADMIN_SESSION_SECRET signs the login cookie — any long random string.
# Generate one with:  openssl rand -hex 32
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --- Site URL --------------------------------------------------------------
# Only needed if Paystack callbacks come back to the wrong domain.
# SITE_URL="https://yourdomain.com"
